00010878                          3813  ; -----------------------------------------------------------------------------
00010878                          3814  ; ENEMDATA STORES, FOR EACH ENEMY IN THE MAP:
00010878                          3815  ; - A LONG STATING SCREEN X (HIGH WORD) AND Y (LOW WORD) WHERE IS THE ENEMY.
00010878                          3816  ; - THE DATA TO PASS TO D1,D2 AND D3 IN ENEMINIT
00010878                          3817  ; - A LONG FFFFFFFF IS USED AS TERMINATOR.
00010878                          3818  ; -----------------------------------------------------------------------------
00010878                          3819  
00010878= FFFFFFFF                3820              DC.L    $FFFFFFFF
00010878= FFFFFFFF                3821  -------------------- end include --------------------
