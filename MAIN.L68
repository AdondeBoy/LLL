000018AE  6000 0076               1038              BRA     .CHNG
000018B2                          1039  
000018B2  0C79 0258 0001769A      1040  .CONT       CMP.W   #MAPTILEW*MAPSCRW-PYRWIDTH-10,(PYRPOSX) ; CHECK IF PLAYER
000018BA  6C00 004A               1041              BGE     .CHNGR                                  ; CHANGE THE MAP
