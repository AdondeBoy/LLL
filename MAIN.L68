00001A46                          1234  
00001A46                          1235  ; --- GENERAL PURPOSE CONSTANTS -----------------------------------------------
00001A46                          1236  
00001A46  =00000010               1237  GENCHRW     EQU     8*2                       ; WIDTH IN PIXELS OF A TEXT CHAR
00001A46  =0000001E               1238  GENCHRH     EQU     15*2                      ; HEIGHT IN PIXELS OF A TEXT CHAR
00001A46  =00000008               1239  GENVCHRW    EQU     8                       
00001A46  =0000000F               1240  GENVCHRH    EQU     15
00001A46                          1241  
00001A46                          1242  
00001A46                          1243  ; --- MAP CONSTANTS -----------------------------------------------------------
00001A46                          1244  
00001A46  =00000001               1245  MAPSCRIX    EQU     1                       ; POSICIÓN X DE LA SCREEN INICIAL
00001A46  =00000000               1246  MAPSCRIY    EQU     0                       ; POSICION Y DE LA SCREEN INICIAL
00001A46                          1247  
00001A46                          1248  
00001A46  =00000005               1249  MAPWIDTH    EQU     5                       ; NUMERO DE SCREENS HORIZONTALES
00001A46  =00000005               1250  MAPHEIGH    EQU     5                       ; NUMERO DE SCREENS VERTICALES
00001A46  =00000028               1251  MAPSCRW     EQU     40                      ; Nº TILES HORIZONTALES POR SCREEN
00001A46  =0000001E               1252  MAPSCRH     EQU     30                      ; Nº TILES VERTICALES POR SCREEN
00001A46  =00000010               1253  MAPTILEW    EQU     16                      ; TILE WIDTH
00001A46  =00000010               1254  MAPTILEH    EQU     16                      ; TILE HEIGHT
00001A46                          1255  
00001A46                          1256  ; --- PLAYER CONSTANTS --------------------------------------------------------
00001A46                          1257  
00001A46  =0000001E               1258  PYRWIDTH    EQU     30                      ; SPRITE WIDTH
00001A46  =0000002A               1259  PYRHEIGH    EQU     42                      ; SPRITE HEIGHT
00001A46  =00000140               1260  PYRXINI     EQU     20*MAPTILEW             ; PLAYER INITIAL X POSITION
00001A46  =00000096               1261  PYRYINI     EQU     12*MAPTILEW-PYRHEIGH    ; PLAYER INITIAL Y POSITION
00001A46                          1262  
00001A46                          1263  
00001A46  =0000000F               1264  PYRSPDX     EQU     15                      ; PLAYER RUNNING X SPEED
00001A46  =0000000F               1265  PYRYSPD     EQU     15                      ; PLAYER FALLING Y SPEED
00001A46  =00000003               1266  PYRSTTIC    EQU     3                       ; PLAYER FRAME STATIC
00001A46                          1267  
00001A46                          1268  ; --- INKLING CONSTANTS ---------------------------------------------------------
00001A46                          1269  
00001A46  =00000006               1270  INKCOLOF    EQU     6                       ; COLOR OFFSET
00001A46  =00000040               1271  INKSPROF    EQU     64                      ; INKLING SPRITE LIST OFFSET
00001A46  =00000018               1272  INKSIZE     EQU     24                      ; INKLING WIDTH AND HEIGHT
00001A46                          1273  
00001A46  =00000011               1274  INKTILE     EQU     17                      ; ID INKLING TILE
00001A46                          1275  
00001A46                          1276  ; --- GAME STATES -------------------------------------------------------------
00001A46                          1277  
00001A46  =FFFFFFFF               1278  STANONE     EQU     -1                      ; ONE USE-ONLY
00001A46  =00000000               1279  STAINTR     EQU     0                       ; INTRO STATE
00001A46  =00000001               1280  STAPLAY     EQU     1                       ; NORMAL GAME STATE
00001A46  =00000002               1281  STAVICT     EQU     2                       ; VICTORY STATE
00001A46                          1282  
00001A46                          1283  ; --- FILE CONSTANTS ----------------------------------------------------------
00001A46                          1284  
00001A46  =0000000D               1285  FILESIZE    EQU     13                      ; IN NUMBER OF BYTES
