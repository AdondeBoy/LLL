00001A46                          1331  GFXDRWID
00001A46                          1332  ; DRAWS A PICTURE BY ID
00001A46                          1333  ; INPUT    - A0 POINTER TO THE LIST OF POINTERS TO PICTURES
00001A46                          1334  ;            D3.W OBJECT ID
00001A46                          1335  ;            D5.W X OFFSET
00001A46                          1336  ;            D6.W Y OFFSET            
00001A46                          1337  ; OUTPUT   - NONE
00001A46                          1338  ; MODIFIES - A1
00001A46                          1339  ; -----------------------------------------------------------------------------  
00001A46  48E7 F8C0               1340              MOVEM.L D0-D4/A0-A1,-(A7)
00001A4A  E55B                    1341              ROL.W   #2,D3                   ; PREPARE INDEX
00001A4C  2270 3000               1342              MOVE.L  (A0,D3.W),A1
00001A50                          1343              
00001A50                          1344              
00001A50                          1345  ; -----------------------------------------------------------------------------
00001A50                          1346  GFXDRPIC
00001A50                          1347  ; DRAWS A PICTURE
00001A50                          1348  ; INPUT    - A1 POINTER TO THE PICTURE
00001A50                          1349  ;            D5.W X OFFSET
00001A50                          1350  ;            D6.W Y OFFSET
00001A50                          1351  ; OUTPUT   - NONE
00001A50                          1352  ; MODIFIES - NONE
00001A50                          1353  ; -----------------------------------------------------------------------------     
00001A50  3019                    1354  .LOOP       MOVE.W  (A1)+,D0                ; COMMAND ID
00001A52  6700 0016               1355              BEQ     .END
00001A56  41F9 00001A70           1356              LEA     .JMPTBL,A0
00001A5C  E558                    1357              ROL.W   #2,D0                   ; TIMES 4 SINCE WE ACCESS LONG
00001A5E  2070 0000               1358              MOVE.L  (A0,D0.W),A0            ; GET THE JUMP ADDRESS
00001A62  E458                    1359              ROR.W   #2,D0
00001A64  0640 004F               1360              ADD.W   #79,D0
00001A68  4ED0                    1361              JMP     (A0)                    ; JUMP!
00001A6A  4CDF 031F               1362  .END        MOVEM.L (A7)+,D0-D4/A0-A1
00001A6E  4E75                    1363              RTS
00001A70= 00001A50                1364  .JMPTBL     DC.L    .LOOP                   ; 00 UNUSED
00001A74= 00001AB4                1365              DC.L    .D1L                    ; 01 SET PEN
00001A78= 00001AB4                1366              DC.L    .D1L                    ; 02 SET FILL
00001A7C= 00001ACC                1367              DC.L    .D1D2W                  ; 03 DRAW PIXEL
00001A80= 00001ABC                1368              DC.L    .D1L2                   ; 04 SET PEN AND FILL
00001A84= 00001ADA                1369              DC.L    .D1D4W                  ; 05 DRAW LINE FULL SPECS
00001A88= 00001ACC                1370              DC.L    .D1D2W                  ; 06 DRAW LINE POLYLINE VERSION
00001A8C= 00001ACC                1371              DC.L    .D1D2W                  ; 07 MOVE TO
00001A90= 00001ADA                1372              DC.L    .D1D4W                  ; 08 DRAW FILLED RECTANGLE
00001A94= 00001ADA                1373              DC.L    .D1D4W                  ; 09 DRAW FILLED ELLIPSE
00001A98= 00001ACC                1374              DC.L    .D1D2W                  ; 10 FLOOD FILL
00001A9C= 00001ADA                1375              DC.L    .D1D4W                  ; 11 DRAW UNFILLED RECTANGLE
00001AA0= 00001ADA                1376              DC.L    .D1D4W                  ; 12 DRAW UNFILLED ELLIPSE
00001AA4= 00001AAC                1377              DC.L    .D1W                    ; 13 SET DRAWING MODE
00001AA8= 00001AAC                1378              DC.L    .D1W                    ; 14 SET PEN WIDTH
00001AAC  3219                    1379  .D1W        MOVE.W  (A1)+,D1                ; GET WORD
00001AAE  4E4F                    1380              TRAP    #15
00001AB0  4EF8 1A50               1381              JMP     .LOOP
00001AB4  2219                    1382  .D1L        MOVE.L  (A1)+,D1                ; GET LONG
00001AB6  4E4F                    1383              TRAP    #15
00001AB8  4EF8 1A50               1384              JMP     .LOOP
00001ABC  2219                    1385  .D1L2       MOVE.L  (A1)+,D1                ; GET LONG AND DO SET PEN AND FILL
00001ABE  103C 0050               1386              MOVE.B  #80,D0
00001AC2  4E4F                    1387              TRAP    #15
00001AC4  5200                    1388              ADDQ.B  #1,D0
00001AC6  4E4F                    1389              TRAP    #15
00001AC8  4EF8 1A50               1390              JMP     .LOOP
