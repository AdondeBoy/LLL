00001858                           938  ; --- SCREEN RELATED CONSTANTS ------------------------------------------------
00001858                           939  
00001858  =000001E0                940  SCRHEIGH    EQU     480                     ; ALTO DE LA PANTALLA
00001858  =00000280                941  SCRWIDTH    EQU     640                     ; ANCHO DE LA PANTALLA
00001858  =00000001                942  SCRIRQ      EQU     1
00001858  =00000028                943  SCRTIM      EQU     40                      ; 40 MS
00001858  =00000014                944  TIMSTRV     EQU     20                      ; 20 MS
00001858                           945  
00001858                           946  
00001858                           947  ; --- TRAP RELATED CONSTANTS --------------------------------------------------
00001858                           948  
00001858  =00000000                949  KBDTRAP     EQU     0                       ; KEYBOARD UPDATE TRAP
00001858  =00000001                950  SCRTRAP     EQU     1
00001858  =00000002                951  MOUTRAP     EQU     2                       ; MOUSE UPDATE TRAP
00001858  =00000004                952  SNDTRAP     EQU     4                       ; SOUND PLAY TRAP
00001858                           953  
00001858                           954  
00001858                           955  ; --- KEY CODES ---------------------------------------------------------------
00001858                           956  
00001858  =00000027                957  KBDRIGHT1   EQU     $27                     ; RIGHT BUTTON KEY
00001858  =00000044                958  KBDRIGHT2   EQU     'D'                     ; RIGHT BUTTON CHARACTER
00001858  =00000025                959  KBDLEFT1    EQU     $25                     ; LEFT BUTTON KEY 
00001858  =00000041                960  KBDLEFT2    EQU     'A'                     ; LEFT BUTTON CHARACTER
00001858  =00000026                961  KBDUP1      EQU     $26                     ; UP BUTTON KEY
00001858  =00000057                962  KBDUP2      EQU     'W'                     ; UP BUTTON CHARACTER
00001858  =00000020                963  KBDSPACE    EQU     $20                     ; SPACE BUTTON KEY
00001858  =0000001B                964  KBDESC      EQU     $1B                     ; PAUSE BUTTON KEY (ESC)
00001858                           965  
00001858                           966  ; --- KEYBOARD MASKS ----------------------------------------------------------
00001858                           967  
00001858  =00000001                968  KBDMSKRT1   EQU     $01                     ; RIGHT BUTTON 1 MASK
00001858  =00000002                969  KBDMSKRT2   EQU     $02                     ; RIGHT BUTTON 2 MASK
00001858  =00000004                970  KBDMSKLF1   EQU     $04                     ; LEFT BUTTON 1 MASK
00001858  =00000008                971  KBDMSKLF2   EQU     $08                     ; LEFT BUTTON 2 MASK
00001858  =00000010                972  KBDMSKUP1   EQU     $10
00001858  =00000020                973  KBDMSKUP2   EQU     $20
00001858  =00000040                974  KBDMSKSPC   EQU     $40                     ; SPACE BUTTON MASK
00001858  =00000080                975  KBDMSKESC   EQU     $80                    ; ESC BUTTON MASK
00001858                           976  
00001858                           977  ; --- KEYBOARD BITPBIT --------------------------------------------------------
00001858                           978  
00001858  =00000000                979  KBDBITRT1   EQU     0
00001858  =00000001                980  KBDBITRT2   EQU     1
00001858  =00000002                981  KBDBITLF1   EQU     2
00001858  =00000003                982  KBDBITLF2   EQU     3
00001858  =00000004                983  KBDBITUP1   EQU     4
00001858  =00000005                984  KBDBITUP2   EQU     5
00001858  =00000006                985  KBDBITSPC   EQU     6
00001858  =00000007                986  KBDBITESC   EQU     7
