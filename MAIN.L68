000018CA  0C79 01AC 0001769C      1044              CMP.W   #MAPTILEH*MAPSCRH-PYRHEIGH-10,(PYRPOSY)
000018D2  6C00 0020               1045              BGE     .CHNGD
000018D6  0C79 000A 0001769C      1046              CMP.W   #10,(PYRPOSY)
