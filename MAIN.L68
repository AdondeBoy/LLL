000018F0  6000 0034               1051              BRA     .CHNG
000018F4  5279 00017692           1052  .CHNGD      ADDQ.W  #1,(MAPPOSY)
000018FA  33FC 0014 0001769C      1053              MOVE.W  #10*2,(PYRPOSY)
00001902  6000 0022               1054              BRA     .CHNG
00001906  5279 00017690           1055  .CHNGR      ADDQ.W  #1,(MAPPOSX)
0000190C  33FC 0014 0001769A      1056              MOVE.W  #10*2,(PYRPOSX)
00001914  6000 0010               1057              BRA     .CHNG
00001918  5379 00017690           1058  .CHNGL      SUBQ.W  #1,(MAPPOSX)
